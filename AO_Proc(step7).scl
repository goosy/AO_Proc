FUNCTION_BLOCK "AO_Proc"
TITLE='Analog output scaling'
VERSION:'0.1'
KNOW_HOW_PROTECT
AUTHOR:Goosy
NAME:AO_Proc
FAMILY:GooLib

CONST
    S7_ZERO := 0;
    S7_SPAN := 27648;
    S7_AO_MIN := -6912;  // 0 mA, only the 4..20 mA output range is supported
    S7_AO_MAX := 32511;
END_CONST

VAR_INPUT
    PV {S7_m_c := 'true'} : REAL ;                   // process value in engineering units
    zero {S7_m_c := 'true'} : REAL ;                 // range low value
    span {S7_m_c := 'true'} : REAL := 100.0;         // range high value
    overflow_SP {S7_m_c := 'true'} : INT := 28000;   // overflow setpoint, raw value
    underflow_SP {S7_m_c := 'true'} : INT := -500;   // underflow setpoint, raw value
    mode {S7_m_c := 'true'} : INT := 0;              // output mode, 0 = 4..20 mA (only supported, reserved)
END_VAR

VAR_OUTPUT
    AO {S7_m_c := 'true'} : WORD ;           // raw channel value
    PV_raw AT AO : INT;
    invalid {S7_m_c := 'true'} : BOOL;       // i.e. mode error OR range error OR overflow OR underflow
    overflow {S7_m_c := 'true'} : BOOL;      // PV above overflow setpoint, output clamped
    underflow {S7_m_c := 'true'} : BOOL;     // PV below underflow setpoint, output clamped
END_VAR

VAR
END_VAR

VAR_TEMP
    value : REAL ;
    high : REAL ;
    low : REAL ;
END_VAR

BEGIN
overflow := FALSE;
underflow := FALSE;
IF mode <> 0 OR span = zero THEN
    // unsupported mode or range error
    PV_raw := S7_ZERO;
    invalid := TRUE;
ELSE
    // clamp limits in raw units, bounded by the S7 analog value range
    IF overflow_SP > S7_AO_MAX THEN
        high := S7_AO_MAX;
    ELSE
        high := overflow_SP;
    END_IF;
    IF underflow_SP < S7_AO_MIN THEN
        low := S7_AO_MIN;
    ELSE
        low := underflow_SP;
    END_IF;
    value := (PV - zero) * S7_SPAN / (span - zero);
    IF value > high THEN
        value := high;
        overflow := TRUE;
    ELSIF value < low THEN
        value := low;
        underflow := TRUE;
    END_IF;
    PV_raw := REAL_TO_INT(value);
    invalid := overflow OR underflow;
END_IF;
END_FUNCTION_BLOCK
