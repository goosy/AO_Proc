//**************************************************************************************
// Copyright Goosy. All Rights Reserved.
// Derived from Step7 AO_Proc with extended attributes
//**************************************************************************************
FUNCTION_BLOCK "AO_Proc"
TITLE = 'Analog output scaling'
{
    S7_m_c := 'true'
}
KNOW_HOW_PROTECT
AUTHOR : Goosy
NAME : AO_Proc
VERSION :'0.2'
FAMILY : GooLib
// ************************************

CONST
    S7_ZERO := 0;
    S7_SPAN := 27648;
    S7_BIPOLAR_ZERO := -27648;    // raw value at range low, cat.3 bipolar
    S7_AO_MIN1 := -6912;          // hardware low limit, cat.1 (0 mA / 0 V)
    S7_AO_MIN2 := 0;              // hardware low limit, cat.2 (0 mA / 0 V)
    S7_AO_MIN3 := -32512;         // hardware low limit, cat.3 (-23.52 mA / -11.76 V)
    S7_AO_MAX := 32511;           // hardware high limit, all categories
    OVERFLOW_SP_DEF := 28000;     // overflow setpoint default, all categories
    UNDERFLOW_SP_DEF1 := -500;    // underflow setpoint default, cat.1 unipolar with offset (4..20 mA, 1..5 V)
    UNDERFLOW_SP_DEF2 := 0;       // underflow setpoint default, cat.2 unipolar (0..20 mA, 0..10 V)
    UNDERFLOW_SP_DEF3 := -28000;  // underflow setpoint default, cat.3 bipolar (+/-20 mA, +/-10 V)
    UNDERFLOW_SP_AUTO := -32768;  // sentinel: use the category default
END_CONST

VAR_INPUT // Input Parameters
PV{ // process value in engineering units
    S7_shortcut := 'Process value';
    S7_m_c := 'true';
    S7_dynamic := 'true';
    S7_archive := 'shortterm'
} :REAL := 0.0;
zero{ // range low value
    S7_shortcut := 'Range low';
    S7_m_c := 'true';
    S7_dynamic := 'true'
    // S7_archive:= 'shortterm'
} : REAL := 0.0;
span{ // range high value
    S7_shortcut := 'Range high';
    S7_m_c := 'true';
    S7_dynamic := 'true'
    // S7_archive:= 'shortterm'
} : REAL := 100.0;
overflow_SP{ // overflow setpoint, raw value
    S7_visible:='false';
    S7_link:='false';
    S7_shortcut := 'Overflow SP';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} : INT := OVERFLOW_SP_DEF;
underflow_SP{ // underflow setpoint, raw value, -32768 = category default
    S7_visible:='false';
    S7_link:='false';
    S7_shortcut := 'Underflow SP';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} : INT := UNDERFLOW_SP_AUTO;
mode{ // output mode, 0 = 4..20 mA, 1 = 0..20 mA, 2 = 0..10 V, 3 = 1..5 V, 4 = +/-10 V, 5 = +/-20 mA
    S7_visible:='false';
    S7_link:='false';
    S7_shortcut := 'Output mode';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} : INT := 0;
END_VAR

VAR_OUTPUT
AO{ // raw channel value
    S7_shortcut := 'Raw value';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} : WORD := S7_ZERO;
PV_raw AT AO : INT;

invalid {
    S7_shortcut := 'Invalid'; // i.e. mode error OR range error OR overflow OR underflow
    S7_m_c := 'true';
    S7_dynamic := 'true'
} :BOOL := FALSE;
overflow{ // PV above overflow setpoint, output clamped
    S7_shortcut := 'Overflow';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} :BOOL := FALSE;
underflow{ // PV below underflow setpoint, output clamped
    S7_shortcut := 'Underflow';
    S7_m_c := 'true';
    S7_dynamic := 'true'
} :BOOL := FALSE;
END_VAR

VAR_IN_OUT
END_VAR

VAR
// Static Variables
END_VAR

VAR_TEMP
// Temporary Variables
value : REAL;
high : REAL;
low : REAL;
raw_zero : REAL;  // raw value at range low
raw_min : INT;    // hardware low limit
def_low : INT;    // underflow setpoint default
mode_err : BOOL;
END_VAR

// Statement Section
BEGIN
overflow := FALSE;
underflow := FALSE;
mode_err := FALSE;
CASE mode OF
    0, 3:  // cat.1 unipolar with offset
        raw_zero := S7_ZERO;
        raw_min := S7_AO_MIN1;
        def_low := UNDERFLOW_SP_DEF1;
    1, 2:  // cat.2 unipolar
        raw_zero := S7_ZERO;
        raw_min := S7_AO_MIN2;
        def_low := UNDERFLOW_SP_DEF2;
    4, 5:  // cat.3 bipolar
        raw_zero := S7_BIPOLAR_ZERO;
        raw_min := S7_AO_MIN3;
        def_low := UNDERFLOW_SP_DEF3;
ELSE
    mode_err := TRUE;
END_CASE;
IF mode_err OR span = zero THEN
    // unsupported mode or range error
    PV_raw := S7_ZERO;
    invalid := TRUE;
ELSE
    // clamp limits in raw units, bounded by the S7 analog value range
    IF overflow_SP > S7_AO_MAX THEN
        high := S7_AO_MAX;
    ELSE
        high := overflow_SP;
    END_IF;
    IF underflow_SP = UNDERFLOW_SP_AUTO THEN
        low := def_low;
    ELSIF underflow_SP < raw_min THEN
        low := raw_min;
    ELSE
        low := underflow_SP;
    END_IF;
    value := raw_zero + (PV - zero) * (S7_SPAN - raw_zero) / (span - zero);
    IF value > high THEN
        value := high;
        overflow := TRUE;
    ELSIF value < low THEN
        value := low;
        underflow := TRUE;
    END_IF;
    PV_raw := REAL_TO_INT(value);
    invalid := overflow OR underflow;
END_IF;

END_FUNCTION_BLOCK
